{
  "name": "pen-khon-dee-frontends",
  "private": true,
  "workspaces": [
    "staff-web",
    "customer-web"
  ],
  "scripts": {
    "dev": "npm run dev:staff",
    "dev:staff": "npm run dev --workspace osteria-nero-frontend",
    "dev:customer": "npm run dev --workspace pen-khon-dee-customer-web",
    "build": "npm run build:staff && npm run build:customer",
    "build:staff": "npm run build --workspace osteria-nero-frontend",
    "build:customer": "npm run build --workspace pen-khon-dee-customer-web"
  }
}
